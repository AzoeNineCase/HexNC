<?xml version="1.0" encoding="utf-8"?>
<!--
    Hexcell Aurora, the fused launcher mark.

    A solid hexagonal tile (candidate B's silhouette, which survives 16 px) filled with
    candidate A's three-stop aurora gradient, a play mark knocked out of the tile so the
    launcher background shows through, and a thin inner rim that keeps the edge crisp on
    dark wallpapers. The knockout is one path with fillType="evenOdd" so the triangle is a
    real hole rather than a second dark shape painted on top.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Tile + knocked-out play mark -->
    <path
        android:fillType="evenOdd"
        android:pathData="M54,26 L78.25,40 L78.25,68 L54,82 L29.75,68 L29.75,40 Z M48.5,43.5 L48.5,64.5 L66.5,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30" android:startY="32"
                android:endX="78" android:endY="80"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF56BFD4" />
                <item android:offset="0.48" android:color="#FF7A73D6" />
                <item android:offset="1.0" android:color="#FFD98CAF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner rim, inset a hair so it reads as light catching the tile's edge -->
    <path
        android:pathData="M54,27.06 L77.33,40.53 L77.33,67.47 L54,80.94 L30.67,67.47 L30.67,40.53 Z"
        android:strokeWidth="1.3"
        android:strokeColor="#78F5F7FC"
        android:strokeLineJoin="round" />
</vector>